  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "unused.comment"
      ],
      "settings": {
        "foreground": "#88717B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc Comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#9C8590",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#E5A0B0"
      }
    },
    {
      "name": "Storage Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E5A0B0"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.assignment",
        "keyword.operator.relational",
        "keyword.operator.bitwise"
      ],
      "settings": {
        "foreground": "#D7A0AE"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#E8B47A"
      }
    },
    {
      "name": "Classes & Interfaces",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.class"
      ],
      "settings": {
        "foreground": "#E8B47A"
      }
    },
    {
      "name": "Types & Primitives",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.type.primitive",
        "storage.type.primitive",
        "storage.type.numeric",
        "storage.type.string",
        "storage.type.boolean"
      ],
      "settings": {
        "foreground": "#D9A1B5"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E8DCE1"
      }
    },
    {
      "name": "Object Properties & Fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#DDC9D2"
      }
    },
    {
      "name": "Constants & Readonly",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#E5C18A"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#C5D6A5"
      }
    },
    {
      "name": "Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#D7A6E0"
      }
    },
    {
      "name": "Escape & RegEx",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "string.regexp punctuation"
      ],
      "settings": {
        "foreground": "#E2A882"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.array"
      ],
      "settings": {
        "foreground": "#B8A2AC"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E58BA2"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#D6B0C0"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "source.css entity.name.tag"
      ],
      "settings": {
        "foreground": "#E5A0B0"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.media",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#D6A4B5"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.w3c-standard-color-name.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#D7A6E0"
      }
    },
    {
      "name": "SQL Keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.data-integrity.sql",
        "keyword.other.alias.sql",
        "source.sql keyword.other"
      ],
      "settings": {
        "foreground": "#D7A0AE"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#D9A1B5"
      }
    },
    {
      "name": "YAML Keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#D9A1B5"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#E58BA2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E8B47A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E5A0B0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#C5D6A5"
      }
    },
    {
      "name": "Markdown Link & URL",
      "scope": [
        "string.other.link.title.markdown",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#9B9AE5"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#B09AA3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Shell & PowerShell Cmdlets & Commands",
      "scope": [
        "support.function.powershell",
        "support.function.command.shell",
        "entity.name.function.powershell"
      ],
      "settings": {
        "foreground": "#E8B47A"
      }
    },
    {
      "name": "Shell & PowerShell Variables",
      "scope": [
        "variable.other.readwrite.powershell",
        "punctuation.definition.variable.powershell",
        "variable.other.normal.shell"
      ],
      "settings": {
        "foreground": "#E8DCE1"
      }
    },
    {
      "name": "Shell & PowerShell Parameters",
      "scope": [
        "support.function.attribute.powershell",
        "variable.parameter.powershell"
      ],
      "settings": {
        "foreground": "#D6B0C0"
      }
    },
    {
      "name": "PHP Variables",
      "scope": [
        "variable.other.php",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#E8DCE1"
      }
    },
    {
      "name": "WordPress Functions & Hooks",
      "scope": [
        "support.function.wordpress"
      ],
      "settings": {
        "foreground": "#E8B47A"
      }
    },
    {
      "name": "C# Attributes",
      "scope": [
        "storage.type.cs",
        "entity.name.type.attribute.cs"
      ],
      "settings": {
        "foreground": "#D9A1B5"
      }
    },
    {
      "name": "Razor Directive & Blazor Components",
      "scope": [
        "keyword.other.directive.razor",
        "entity.name.tag.razor",
        "support.class.blazor"
      ],
      "settings": {
        "foreground": "#E58BA2"
      }
    },
    {
      "name": "Python Self & Magic Methods",
      "scope": [
        "variable.language.special.self.python",
        "variable.language.special.cls.python",
        "support.variable.magic.python"
      ],
      "settings": {
        "foreground": "#E5A0B0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#E8B47A"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#E5A0B0",
    "keyword.control": "#E5A0B0",
    "function": "#E8B47A",
    "function.declaration": "#E8B47A",
    "method": "#E8B47A",
    "method.declaration": "#E8B47A",
    "class": "#E8B47A",
    "class.declaration": "#E8B47A",
    "interface": "#E8B47A",
    "struct": "#E8B47A",
    "type": "#D9A1B5",
    "type.defaultLibrary": "#D9A1B5",
    "typeParameter": "#D9A1B5",
    "enum": "#E8B47A",
    "enumMember": "#E5C18A",
    "variable": "#E8DCE1",
    "variable.readonly": "#E5C18A",
    "variable.defaultLibrary": "#E5C18A",
    "property": "#DDC9D2",
    "property.readonly": "#E5C18A",
    "parameter": "#E8DCE1",
    "string": "#C5D6A5",
    "number": "#D7A6E0",
    "comment": {
      "foreground": "#88717B",
      "italic": true
    },
    "regexp": "#E2A882",
    "operator": "#D7A0AE",
    "namespace": "#E8B47A",
    "jsx.tag": "#E58BA2",
    "jsx.attribute": "#D6B0C0"
